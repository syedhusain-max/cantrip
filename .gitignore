# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Agent skills: installed tooling, not part of the app. Kept out of the
# public repo — skills-lock.json records where they came from, so they can
# be reinstalled without shipping their contents.
.agents/
.claude/

# Working notes: architecture rationale, open product decisions, launch
# plans. Useful to whoever is building this, not something to publish.
CLAUDE.md

# Android release signing: paths and passwords, never committed.
android/key.properties
*.jks
*.keystore
